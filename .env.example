# Oturum imzalama anahtarı (zorunlu, üretimde rastgele ve uzun)
AUTH_SECRET=change-me-to-a-long-random-string
# Müşteri/sipariş deposu dizini (varsayılan ./data). Odoo bağlantısı gelene kadar dosya tabanlı.
MAXIMUS_DATA_DIR=./data

# Yönetim paneli (/beheer) şifresi ve yeni kayıt bildirimi için sahibin WhatsApp numarası (ülke koduyla, örn. 32467077164)
ADMIN_PASSWORD=
ADMIN_WHATSAPP=

# WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=maximus-verify
WHATSAPP_APP_SECRET=

# Claude API (ajan). Boşsa kural tabanlı yedek akış çalışır.
ANTHROPIC_API_KEY=
WHATSAPP_AGENT_MODEL=claude-opus-5

# Hızlı Sesli Sipariş: kayıt → Whisper (metin) → GPT-4o-mini (kalemler) → katalog eşleştirme → sepet.
# Tek anahtar yeter: OPENAI_API_KEY (değer yalnızca anahtar olmalı; yanlışlıkla curl örneği yapıştırılırsa yine ayıklanır).
OPENAI_API_KEY=
# İsteğe bağlı: uç nokta/model geçersiz kılma
VOICE_STT_MODEL=whisper-1
VOICE_LLM_MODEL=gpt-4o-mini
VOICE_TTS_MODEL=tts-1
VOICE_TTS_VOICE=onyx
# "Özeti dinle" düğmesini kapatmak için: VOICE_TTS_DISABLED=1
