# Oturum imzalama anahtarı (zorunlu, üretimde rastgele ve uzun)
AUTH_SECRET=change-me-to-a-long-random-string
# Müşteri/sipariş veritabanı (Postgres). Doluysa tüm veri buraya yazılır.
# Vercel'de zorunludur: sunucusuz dosya sistemi salt okunurdur, dosya tabanlı depo orada çalışmaz.
# Vercel'in Neon/Postgres entegrasyonu bu değişkeni kendisi ekler (DATABASE_URL ya da POSTGRES_URL).
DATABASE_URL=

# Yukarısı boşken kullanılan dosya tabanlı deponun dizini (yalnız yerel geliştirme).
MAXIMUS_DATA_DIR=./data

# Postgres deposunun testlerini çalıştırmak için (boşsa o testler atlanır)
TEST_DATABASE_URL=

# Yönetim paneli (/beheer) şifresi ve yeni kayıt bildirimi için sahibin WhatsApp numarası (ülke koduyla, örn. 32467077164)
ADMIN_PASSWORD=
ADMIN_WHATSAPP=

# WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=maximus-verify
WHATSAPP_APP_SECRET=

# Claude API (ajan). Boşsa kural tabanlı yedek akış çalışır.
ANTHROPIC_API_KEY=
WHATSAPP_AGENT_MODEL=claude-opus-5
