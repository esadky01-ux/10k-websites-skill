# Oturum imzalama anahtarı (zorunlu, üretimde rastgele ve uzun)
AUTH_SECRET=change-me-to-a-long-random-string

# ── Müşteri/sipariş deposu ───────────────────────────────────────────
# İki uygulama vardır, ikisi de aynı arayüzü kullanır (src/server/store.ts):
#   file     — data/store.json. YALNIZCA yerel geliştirme.
#   postgres — PostgreSQL (Neon / Vercel Postgres). ÜRETİM için zorunlu.
#
# ÖNEMLİ: Vercel'de dosya tabanlı depo ÇALIŞMAZ. Fonksiyon dosya sistemi /tmp dışında
# salt okunurdur (yazma "ENOENT: mkdir '/var/task/data'" ile 500 döndürür) ve /tmp her
# çağrıda sıfırlanır; müşteri kaydolur, sonraki istekte yok olur. Üretimde mutlaka
# MAXIMUS_DATABASE_URL tanımlayın.
#
# Boş bırakılırsa: bağlantı dizesi varsa postgres, yoksa file seçilir.
MAXIMUS_STORE=
# PostgreSQL bağlantı dizesi. Neon'da havuzlanmış ("-pooler") uç noktayı kullanın:
# postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/maximus?sslmode=require
# DATABASE_URL ve POSTGRES_URL de okunur (Vercel Postgres bunları kendisi tanımlar).
MAXIMUS_DATABASE_URL=
# Şemayı kurmak için: npm run db:migrate (idempotent, PostgresStore ilk kullanımda da kurar)

# Uyumluluk testlerinin karşı koşacağı BOŞ test veritabanı (tanımsızsa o testler atlanır).
# DİKKAT: tablolarını TRUNCATE eder — asla üretim veritabanını vermeyin.
MAXIMUS_TEST_DATABASE_URL=

# Yalnızca file deposu için: veri dizini (varsayılan ./data)
MAXIMUS_DATA_DIR=./data

# Yönetim paneli (/beheer) şifresi ve yeni kayıt bildirimi için sahibin WhatsApp numarası (ülke koduyla, örn. 32467077164)
ADMIN_PASSWORD=
ADMIN_WHATSAPP=

# WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=maximus-verify
WHATSAPP_APP_SECRET=

# Claude API (ajan). Boşsa kural tabanlı yedek akış çalışır.
ANTHROPIC_API_KEY=
WHATSAPP_AGENT_MODEL=claude-opus-5
