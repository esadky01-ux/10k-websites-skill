# Oturum imzalama anahtarı (zorunlu, üretimde rastgele ve uzun)
AUTH_SECRET=change-me-to-a-long-random-string
# Müşteri/sipariş deposu dizini (varsayılan ./data). Odoo bağlantısı gelene kadar dosya tabanlı.
MAXIMUS_DATA_DIR=./data

# Yönetim paneli (/beheer) şifresi ve yeni kayıt bildirimi için sahibin WhatsApp numarası (ülke koduyla, örn. 32467077164)
ADMIN_PASSWORD=
ADMIN_WHATSAPP=

# WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=maximus-verify
WHATSAPP_APP_SECRET=

# Claude API (ajan). Boşsa kural tabanlı yedek akış çalışır.
ANTHROPIC_API_KEY=
WHATSAPP_AGENT_MODEL=claude-opus-5
VOICE_AGENT_MODEL=claude-opus-5

# Sesli asistan (Maximus Dijital Plasiyer). Boşsa tarayıcı modu: Web Speech API + Claude.
# Dolduğunda /api/voice-agent/webrtc üzerinden gerçek zamanlı ses köprüsü etkinleşir (anahtar tarayıcıya inmez).
VOICE_API_KEY=
VOICE_REALTIME_URL=
VOICE_MODEL=
# Kayıt yedeği: tarayıcıda konuşma tanıma yoksa ses kaydı bu Whisper uyumlu uç noktaya gider (multipart file/model/language → { text }).
VOICE_STT_URL=
VOICE_STT_MODEL=whisper-1
