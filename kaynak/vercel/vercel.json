{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "regions": ["fra1"],
  "functions": {
    "api/create.js": { "maxDuration": 30 },
    "api/webhook.js": { "maxDuration": 30 },
    "api/success.js": { "maxDuration": 20 },
    "api/orders.js": { "maxDuration": 20 },
    "api/test.js": { "maxDuration": 20 }
  },
  "rewrites": [
    { "source": "/pay/create.php", "destination": "/api/create" },
    { "source": "/pay/webhook.php", "destination": "/api/webhook" },
    { "source": "/pay/success.php", "destination": "/api/success" },
    { "source": "/pay/orders.php", "destination": "/api/orders" },
    { "source": "/pay/test.php", "destination": "/api/test" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:dil(fr|nl|en|tr)/index.html", "destination": "/:dil/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://maps.gstatic.com https://maps.googleapis.com; font-src 'self' data:; connect-src 'self' https://maps.googleapis.com; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://www.mollie.com https://*.mollie.com; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/assets/(site\\.css|app\\.js|kok\\.css|kok\\.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/assets/(fonts|icons)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
